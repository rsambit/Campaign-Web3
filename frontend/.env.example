# Environment Variables for Web3 Configuration

# Alchemy API Key (Optional - for better RPC performance)
# Get your free API key from https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_api_key_here

# WalletConnect Project ID (Required for WalletConnect functionality)
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here
